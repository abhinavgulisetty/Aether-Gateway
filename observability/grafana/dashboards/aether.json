{
  "id": null,
  "uid": "aether-systems",
  "title": "Aether \u2022 Local Systems Observatory",
  "tags": [
    "aether",
    "systems",
    "local"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Gateway Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Request rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aether-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(aether_requests_total[$__rate_interval]))",
          "legendFormat": "Request rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "axisSoftMax": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Success rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aether-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(aether_requests_total{status=~\"2..|3..\"}[$__rate_interval])) / clamp_min(sum(rate(aether_requests_total[$__rate_interval])), 0.001)",
